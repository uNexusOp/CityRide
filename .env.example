# Generate an unpredictable secret before deployment, for example with:
# openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
CITYRIDE_PORT=8080
FRONTEND_URL=http://localhost:8080

# Optional first administrator. Required when running with SPRING_PROFILES_ACTIVE=production
# if an administrator has not already been provisioned.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Stripe test-mode keys. Never use a publishable key as the secret key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Google OAuth credentials.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP configuration for emailed PDF receipts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
